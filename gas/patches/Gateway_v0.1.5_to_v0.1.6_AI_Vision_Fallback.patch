+function 製造AI閘道_Vision主庫Fallback_(partNo) {
+  var sheetName = 製造AI閘道_工作表_.AI視覺檢查紀錄;
+  var table;
+  try {
+    table = 製造AI閘道_讀分頁_(sheetName);
+  } catch (err) {
+    if (err && err.errorCode === 'SOURCE_NOT_FOUND') {
+      return {found:false,data:null,warnings:['VISION_SHEET_NOT_FOUND：正式主庫尚無 09_AI視覺檢查紀錄。']};
+    }
+    throw err;
+  }
+
+  var rows = 製造AI閘道_顯示物件列_(table).filter(function (r) {
+    return 製造AI閘道_精確相等_(r.partNo, partNo) && 製造AI閘道_文字_(r.inspectionId) !== '';
+  });
+  if (!rows.length) return {found:false,data:null,warnings:['Vision 主庫查無此料號的檢查紀錄。']};
+
+  var productionRows = rows.filter(function (r) {
+    return 製造AI閘道_文字_(r.releaseStatus).toUpperCase() === 'PRODUCTION_RELEASED'
+      && !!製造AI閘道_日期時間ISO_(r.inspectedAt);
+  });
+  if (productionRows.length) {
+    productionRows.sort(function (a,b) {
+      return String(製造AI閘道_日期時間ISO_(b.inspectedAt)||'')
+        .localeCompare(String(製造AI閘道_日期時間ISO_(a.inspectedAt)||''));
+    });
+    return {
+      found:true,
+      data:製造AI閘道_Vision列轉資料_(productionRows[0],'VISION_MASTER_SHEET'),
+      warnings:productionRows.length>1?['VISION_MULTI_RELEASED：找到多筆量產已發布 Vision 紀錄，回傳 inspectedAt 最新一筆。']:[]
+    };
+  }
+
+  var passCandidate=0, review=0, ngCandidate=0, models=[], geometries=[], validationDates=[];
+  rows.forEach(function(r){
+    var result=製造AI閘道_文字_(r.result).toUpperCase();
+    if(result==='PASS_CANDIDATE') passCandidate++;
+    else if(result==='REVIEW') review++;
+    else if(result==='NG_CANDIDATE'||result==='NG') ngCandidate++;
+    if(製造AI閘道_文字_(r.modelVersion)) models.push(製造AI閘道_文字_(r.modelVersion));
+    if(製造AI閘道_文字_(r.geometryVersion)) geometries.push(製造AI閘道_文字_(r.geometryVersion));
+    if(製造AI閘道_正規日期_(r.validationDate)) validationDates.push(製造AI閘道_正規日期_(r.validationDate));
+  });
+
+  return {
+    found:false,
+    data:{
+      partNo:partNo,
+      pilotRecordCount:rows.length,
+      passCandidateCount:passCandidate,
+      reviewCount:review,
+      ngCandidateCount:ngCandidate,
+      modelVersions:製造AI閘道_不重複_(models),
+      geometryVersions:製造AI閘道_不重複_(geometries),
+      latestValidationDate:validationDates.length?validationDates.sort().reverse()[0]:null,
+      validationStage:'PILOT_OFFLINE',
+      releaseStatus:'NOT_PRODUCTION_RELEASED'
+    },
+    warnings:[
+      'VISION_PILOT_ONLY：主庫有 '+rows.length+' 筆離線 Pilot Vision 證據，但尚未量產發布。',
+      'VISION_PILOT_SUMMARY：PASS_CANDIDATE='+passCandidate+'，REVIEW='+review+'，NG_CANDIDATE='+ngCandidate+'。',
+      'VISION_NOT_PRODUCTION_RELEASED：PASS_CANDIDATE 不等於正式 PASS；REVIEW 不等於正式 NG。'
+    ]
+  };
+}
