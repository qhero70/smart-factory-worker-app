/**
 * ============================================================
 * 化新精密｜智慧5S｜LINE 一鍵正式啟用
 * 版本：1.1.0
 * ============================================================
 *
 * 用途：
 * 1. 執行智慧5S受控群組測試。
 * 2. 驗證唯一 LINE Bot 橋接健康狀態。
 * 3. 建立每小時智慧5S通知觸發器。
 * 4. 驗證舊 LINE 模組相容層「取得試算表()」。
 * 5. 建立每日約 08:05 智慧5S主管戰情觸發器。
 * 6. 立即處理目前等待發送的智慧5S通知。
 *
 * 前提：同一 Apps Script 專案已存在：
 * - 智慧5S_LINE唯一Bot橋接.gs
 * - 智慧5S_LINE相容層與每日戰情.gs
 *
 * 注意：
 * - 不建立第二個 LINE Bot。
 * - 不建立第二套資料庫。
 * - 全程沿用 NEXUS OS 既有唯一 LINE Bot。
 * ============================================================
 */

function 智慧5S_LINE一鍵_受控測試() {
  return 智慧5S_LINE橋接_發送區域測試(
    'A9-1070檢驗桌',
    '確認發送測試'
  );
}

function 智慧5S_LINE一鍵_相容層健康檢查() {
  if (typeof 智慧5S_相容層健康檢查 !== 'function') {
    return {
      成功: false,
      訊息: '找不到「智慧5S_相容層健康檢查()」，請先確認智慧5S_LINE相容層與每日戰情.gs 已載入。'
    };
  }

  return 智慧5S_相容層健康檢查();
}

function 智慧5S_LINE一鍵_正式啟用() {
  var 健康 = 智慧5S_LINE橋接_健康檢查();

  if (!健康 || 健康.可正式啟用 !== true) {
    return {
      成功: false,
      階段: '正式啟用前健康檢查',
      健康檢查: 健康,
      訊息: '尚未通過正式啟用條件，未建立每小時通知排程。'
    };
  }

  return 智慧5S_LINE橋接_建立每小時觸發器();
}

function 智慧5S_LINE一鍵_建立每日戰情觸發器() {
  if (typeof 智慧5S_每日戰情_建立每日觸發器 !== 'function') {
    return {
      成功: false,
      訊息: '找不到「智慧5S_每日戰情_建立每日觸發器()」。'
    };
  }

  return 智慧5S_每日戰情_建立每日觸發器();
}

function 智慧5S_LINE一鍵_立即發送待通知() {
  return 智慧5S_LINE橋接_處理待通知(30);
}

function 智慧5S_LINE一鍵_完整啟用流程() {
  var 執行結果 = [];

  try {
    執行結果.push('================================');
    執行結果.push('化新精密｜智慧5S LINE 正式啟用 v1.1.0');
    執行結果.push('================================');

    執行結果.push('【1/6】執行智慧5S群組受控測試');
    var 測試 = 智慧5S_LINE一鍵_受控測試();
    執行結果.push('受控測試結果：' + JSON.stringify(測試));

    if (!測試 || 測試.成功 !== true) {
      throw new Error('受控測試失敗：' + JSON.stringify(測試));
    }

    執行結果.push('【2/6】執行 LINE 橋接健康檢查');
    var 橋接健康 = 智慧5S_LINE橋接_健康檢查();
    執行結果.push('LINE 橋接健康檢查：' + JSON.stringify(橋接健康));

    if (!橋接健康 || 橋接健康.可正式啟用 !== true) {
      throw new Error('LINE 橋接尚未符合正式啟用條件：' + JSON.stringify(橋接健康));
    }

    執行結果.push('【3/6】建立每小時智慧5S通知觸發器');
    var 每小時結果 = 智慧5S_LINE一鍵_正式啟用();
    執行結果.push('每小時觸發器結果：' + JSON.stringify(每小時結果));

    if (!每小時結果 || 每小時結果.成功 !== true) {
      throw new Error('每小時觸發器建立失敗：' + JSON.stringify(每小時結果));
    }

    執行結果.push('【4/6】執行相容層健康檢查');
    var 相容健康 = 智慧5S_LINE一鍵_相容層健康檢查();
    執行結果.push('相容層健康檢查：' + JSON.stringify(相容健康));

    if (!相容健康 || 相容健康.成功 !== true) {
      throw new Error('相容層健康檢查失敗：' + JSON.stringify(相容健康));
    }

    執行結果.push('【5/6】建立每日約08:05智慧5S主管戰情觸發器');
    var 每日結果 = 智慧5S_LINE一鍵_建立每日戰情觸發器();
    執行結果.push('每日戰情觸發器結果：' + JSON.stringify(每日結果));

    if (!每日結果 || 每日結果.成功 !== true) {
      throw new Error('每日戰情觸發器建立失敗：' + JSON.stringify(每日結果));
    }

    執行結果.push('【6/6】立即處理等待發送的智慧5S通知');
    var 發送 = 智慧5S_LINE一鍵_立即發送待通知();
    執行結果.push('待通知處理結果：' + JSON.stringify(發送));

    執行結果.push('================================');
    執行結果.push('智慧5S LINE 與每日戰情自動化正式啟用完成');
    執行結果.push('================================');

    Logger.log(執行結果.join('\n'));

    return {
      成功: Boolean(發送 && 發送.成功 !== false),
      版本: '1.1.0',
      階段: '完整流程完成',
      受控測試: 測試,
      LINE橋接健康檢查: 橋接健康,
      每小時通知觸發器: 每小時結果,
      相容層健康檢查: 相容健康,
      每日戰情觸發器: 每日結果,
      待通知處理: 發送,
      訊息: '智慧5S LINE、每小時通知與每日08:05主管戰情自動化已完整啟用。'
    };

  } catch (錯誤) {
    執行結果.push('執行失敗：' + String(錯誤 && 錯誤.message ? 錯誤.message : 錯誤));
    Logger.log(執行結果.join('\n'));
    throw 錯誤;
  }
}
