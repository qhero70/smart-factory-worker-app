/**
 * 化新精密｜智慧5S｜LINE 一鍵啟用
 * 版本：1.0.0
 * 用途：避免 Apps Script 編輯器無法直接傳入函式參數。
 * 前提：同一 Apps Script 專案中已存在「智慧5S_LINE唯一Bot橋接.gs」。
 */

function 智慧5S_LINE一鍵_受控測試() {
  return 智慧5S_LINE橋接_發送區域測試('A9-1070檢驗桌', '確認發送測試');
}

function 智慧5S_LINE一鍵_正式啟用() {
  var 健康 = 智慧5S_LINE橋接_健康檢查();
  if (!健康 || 健康.可正式啟用 !== true) {
    return {
      成功: false,
      階段: '正式啟用前健康檢查',
      健康檢查: 健康,
      訊息: '尚未通過正式啟用條件，未建立排程。請先執行「智慧5S_LINE一鍵_受控測試」。'
    };
  }
  return 智慧5S_LINE橋接_建立每小時觸發器();
}

function 智慧5S_LINE一鍵_立即發送待通知() {
  return 智慧5S_LINE橋接_處理待通知(20);
}

function 智慧5S_LINE一鍵_完整啟用流程() {
  var 測試 = 智慧5S_LINE一鍵_受控測試();
  if (!測試 || 測試.成功 !== true) {
    return {
      成功: false,
      階段: '受控測試',
      測試結果: 測試,
      訊息: '受控測試失敗，已停止後續正式啟用。'
    };
  }

  var 啟用 = 智慧5S_LINE一鍵_正式啟用();
  if (!啟用 || 啟用.成功 !== true) {
    return {
      成功: false,
      階段: '建立每小時觸發器',
      測試結果: 測試,
      啟用結果: 啟用,
      訊息: '受控測試成功，但正式啟用未完成。'
    };
  }

  var 發送 = 智慧5S_LINE一鍵_立即發送待通知();
  return {
    成功: Boolean(發送 && 發送.成功 !== false),
    階段: '完整流程完成',
    測試結果: 測試,
    啟用結果: 啟用,
    發送結果: 發送,
    訊息: '智慧5S LINE 受控測試、正式排程建立與待通知立即處理已完成。'
  };
}
