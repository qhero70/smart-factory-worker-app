}

function 報工作業70_確保欄位_(工作表, 欄位清單) {
  var 最後欄 = Math.max(工作表.getLastColumn(), 1);
  var 表頭 = 工作表.getRange(1, 1, 1, 最後欄).getDisplayValues()[0].map(報工作業70_文字_);
  var 缺少 = 欄位清單.filter(function(欄位) { return 表頭.indexOf(欄位) < 0; });
  if (缺少.length) 工作表.getRange(1, 最後欄 + 1, 1, 缺少.length).setValues([缺少]);
  工作表.setFrozenRows(1);
}

function 報工作業70_依表頭新增_(工作表, 物件) {
  var 表頭 = 工作表.getRange(1, 1, 1, 工作表.getLastColumn()).getDisplayValues()[0].map(報工作業70_文字_);
  工作表.appendRow(表頭.map(function(欄位) {
    return 物件[欄位] !== undefined ? 物件[欄位] : '';
  }));
}

function 報工作業70_既有不良鍵_(工作表, 報工編號) {
  var 結果 = {};
  if (!報工編號 || 工作表.getLastRow() < 2) return 結果;
  var 值 = 工作表.getDataRange().getDisplayValues();
  var 表頭 = 值[0].map(報工作業70_文字_);
  var 報工欄 = 表頭.indexOf('報工編號');
  var 代碼欄 = 表頭.indexOf('不良代碼');
  if (報工欄 < 0) return 結果;
  for (var r = 1; r < 值.length; r++) {
    if (報工作業70_文字_(值[r][報工欄]) !== 報工編號) continue;
    var 代碼 = 代碼欄 >= 0 ? 報工作業70_文字_(值[r][代碼欄]) : '';
    結果[報工編號 + '|' + 代碼] = true;
  }
  return 結果;
}

