        縮圖網址: 基本.縮圖網址 || 照片.縮圖網址 || '',
        Google檔案ID: 基本.Google檔案ID || 照片.Google檔案ID || ''
      };
    });
    var 工序清單 = 報工作業70_拆清單_(工序文字);
    var 產品照片 = 報工作業70_找照片_(照片索引, '產品', [產品編號, 客戶品號, 品名]);
    var 標準產能 = 是舊欄位格式 ? 報工作業70_文字_(原始[22]) : 報工作業70_取值_(項目, ['標準產能', '8小時標準產能', '產能8H']);
    var 標準工時 = 是舊欄位格式 ? 報工作業70_文字_(原始[23]) : 報工作業70_取值_(項目, ['標準工時_秒', '標準工時']);
    結果.push({
