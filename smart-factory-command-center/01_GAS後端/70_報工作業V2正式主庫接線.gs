    var 品名 = 是舊欄位格式 ? 報工作業70_文字_(原始[3]) : 報工作業70_取值_(項目, ['品名', '產品名稱']);
    var 產品 = 產品索引[報工作業70_鍵_(產品編號)] || 產品索引[報工作業70_鍵_(報工作業70_去前導零_(產品編號))] || 產品索引[報工作業70_鍵_(客戶品號)] || {};
    產品編號 = 產品.產品編號 || 產品編號;
    客戶品號 = 產品.客戶品號 || 客戶品號;
    品名 = 產品.品名 || 品名;

    var 工站名稱 = 是舊欄位格式 ? 報工作業70_文字_(原始[7]) : 報工作業70_取值_(項目, ['報工工站名稱', '工站名稱', '工站']);
    var 工序文字 = 是舊欄位格式 ? 報工作業70_文字_(原始[5]) : 報工作業70_取值_(項目, ['工序清單', '工序', '工站代碼']);
    var 機台文字 = 是舊欄位格式 ? 報工作業70_文字_(原始[10]) : 報工作業70_取值_(項目, ['機台編號清單', '機台清單', '機台編號']);
    var 型號文字 = 是舊欄位格式 ? 報工作業70_文字_(原始[11]) : '';
    var 區域 = 是舊欄位格式 ? 報工作業70_文字_(原始[8]) : 報工作業70_取值_(項目, ['區域', '區域清單']);
    var 啟用 = 是舊欄位格式 ? 報工作業70_文字_(原始[18]) : 報工作業70_取值_(項目, ['啟用', '狀態']);
