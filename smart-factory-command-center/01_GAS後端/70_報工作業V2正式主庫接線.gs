function 報工作業70_整理不良代碼_(列) {
  var 結果 = { Z: [], Y: [] };
  列.forEach(function(項目) {
    var 原始 = 項目.__原始 || [];
    var 代碼 = 報工作業70_取值_(項目, ['不良代碼', '代碼']) || 報工作業70_文字_(原始[0]);
    var 名稱 = 報工作業70_取值_(項目, ['不良名稱', '名稱']) || 報工作業70_文字_(原始[1]);
    var 分類 = 報工作業70_取值_(項目, ['分類']);
    var 英文名稱 = 報工作業70_取值_(項目, ['英文名稱']);
    if (!/^[ZY]$/i.test(分類) && /^[ZY]$/i.test(英文名稱)) {
      分類 = 英文名稱;
      英文名稱 = 報工作業70_文字_(原始[3]);
    }
    分類 = 報工作業70_文字_(分類 || 代碼.charAt(0)).toUpperCase();
    if (!代碼 || !名稱) return;
    if (!結果[分類]) 結果[分類] = [];
    結果[分類].push({
      代碼: 代碼,
      名稱: 名稱,
      英文名稱: 英文名稱,
      責任歸屬: 報工作業70_取值_(項目, ['責任歸屬'])
    });
  });
  ['Z', 'Y'].forEach(function(分類) {
    結果[分類].sort(function(a, b) { return a.代碼.localeCompare(b.代碼, 'zh-Hant', { numeric: true }); });
  });
  return 結果;
}

function 報工作業70_建立照片索引_(列) {
  var 索引 = { 人員: {}, 產品: {}, 機台: {}, 工站: {}, __筆數: 0 };
  列.forEach(function(項目) {
    var 原始 = 項目.__原始 || [];
    var 類型 = 報工作業70_取值_(項目, ['照片類型', '類型']) || 報工作業70_文字_(原始[0]);
    var 對應主鍵 = 報工作業70_取值_(項目, ['對應主鍵', '對應ID', '對應編號']) || 報工作業70_文字_(原始[1]);
    var 網址 = 報工作業70_取值_(項目, ['照片網址', '網址', '圖片網址']);
    var 縮圖 = 報工作業70_取值_(項目, ['縮圖網址']);
    var 檔案ID = 報工作業70_取值_(項目, ['Google檔案ID', '檔案ID']);
    原始.forEach(function(值) {
      值 = 報工作業70_文字_(值);
      if (!網址 && /^https?:\/\//i.test(值)) 網址 = 值;
      if (!檔案ID && !/^https?:\/\//i.test(值) && /^[A-Za-z0-9_-]{20,}$/.test(值)) 檔案ID = 值;
    });
    類型 = 類型.replace('照片', '');
    if (!索引[類型]) 索引[類型] = {};
    if (!對應主鍵) return;
    if (!網址 && 檔案ID) 網址 = 'https://drive.google.com/thumbnail?id=' + 檔案ID + '&sz=w800';
    if (!縮圖) 縮圖 = 網址;
    索引[類型][報工作業70_鍵_(對應主鍵)] = {
      照片網址: 報工作業70_轉圖片網址_(網址),
      縮圖網址: 報工作業70_轉圖片網址_(縮圖),
      Google檔案ID: 檔案ID
    };
    索引.__筆數++;
  });
  return 索引;
}

function 報工作業70_找照片_(索引, 類型, 主鍵清單) {
  var 類型索引 = 索引[類型] || {};
  for (var i = 0; i < 主鍵清單.length; i++) {
    var 結果 = 類型索引[報工作業70_鍵_(主鍵清單[i])];
    if (結果) return 結果;
  }
  return { 照片網址: '', 縮圖網址: '', Google檔案ID: '' };
}

function 報工作業70_儲存現場照片_(清單, 資訊) {
  if (!Array.isArray(清單) || !清單.length) return [];
  var 結果 = [];
  var 根目錄;
  try {
    根目錄 = 報工作業70_取得或建立資料夾_('06_照片資料庫_報工作業V2');
    根目錄 = 報工作業70_取得或建立子資料夾_(根目錄, 資訊.作業日 || 報工作業70_取得作業日_());
    根目錄 = 報工作業70_取得或建立子資料夾_(根目錄, 資訊.報工編號);
  } catch (錯誤) {
    return 結果;
  }
  for (var i = 0; i < 清單.length; i++) {
    var 項目 = 清單[i] || {};
    var Base64 = 報工作業70_文字_(項目.Base64 || 項目.base64);
    if (!Base64) continue;
    if (Base64.indexOf(',') >= 0) Base64 = Base64.split(',').pop();
    try {
      var MIME = 報工作業70_文字_(項目.MIME類型 || 項目.mime) || 'image/jpeg';
      var 副檔名 = MIME.indexOf('png') >= 0 ? 'png' : 'jpg';
      var 檔名 = 資訊.報工編號 + '_' + String(i + 1) + '.' + 副檔名;
      var 檔案 = 根目錄.createFile(Utilities.newBlob(Utilities.base64Decode(Base64), MIME, 檔名));
      try { 檔案.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (忽略) {}
      var ID = 檔案.getId();
      結果.push({
        檔名: 檔名,
        Google檔案ID: ID,
        照片網址: 'https://drive.google.com/file/d/' + ID + '/view',
        縮圖網址: 'https://drive.google.com/thumbnail?id=' + ID + '&sz=w800',
        MIME類型: MIME,
        備註: 報工作業70_文字_(項目.備註)
      });
    } catch (錯誤) {}
  }
  return 結果;
}

function 報工作業70_取得或建立資料夾_(名稱) {
  var 結果 = DriveApp.getFoldersByName(名稱);
  return 結果.hasNext() ? 結果.next() : DriveApp.createFolder(名稱);
}

function 報工作業70_取得或建立子資料夾_(父層, 名稱) {
