/**
 * 70_報工作業V2正式主庫接線.gs
 * 版本：v1.8.6
 *
 * 用途：
 * 1. 讓 07_報工作業V2.html 直接讀取唯一正式主資料庫。
 * 2. 提供人員、產品、途程、機台、不良代碼與班別資料。
 * 3. 將正式報工寫入 09_報工，將不良明細寫入 09_不良紀錄。
 * 4. 不宣告 doGet / doPost，不影響既有 LINE Bot 主入口。
 */

var 報工作業70_版本 = 'v1.8.6_70_報工作業V2正式主庫接線';
var 報工作業70_正式主庫ID = '19osmTlQQ9obDmVvmv5uphFHRwCtd2pkFhe6p3pYMSn8';
var 報工作業70_時區 = 'Asia/Taipei';

/** 07_報工作業V2.html 的正式初始化入口。 */
function 取得報工作業v2初始資料() {
  var 試算表 = 報工作業70_取得正式主庫_();
  var 人員原始 = 報工作業70_讀表_(試算表, '01_人員主檔');
  var 產品原始 = 報工作業70_讀表_(試算表, '02_產品主檔');
  var 機台原始 = 報工作業70_讀表_(試算表, '03_機台主檔');
  var 途程原始 = 報工作業70_讀表_(試算表, '08_工站途程機台主檔');
  var 不良原始 = 報工作業70_讀表_(試算表, '05_不良代碼主檔');
  var 照片原始 = 報工作業70_讀表_(試算表, '06_照片資料庫');

  var 照片索引 = 報工作業70_建立照片索引_(照片原始);
  var 人員 = 報工作業70_整理人員_(人員原始, 照片索引);
  var 產品索引 = 報工作業70_建立產品索引_(產品原始, 照片索引);
  var 機台索引 = 報工作業70_建立機台索引_(機台原始, 照片索引);
  var 報工工站群組 = 報工作業70_整理途程_(途程原始, 產品索引, 機台索引, 照片索引);
  var 不良原因 = 報工作業70_整理不良代碼_(不良原始);

  return {
    成功: true,
    版本: 報工作業70_版本,
    正式主資料庫ID: 報工作業70_正式主庫ID,
    作業日: 報工作業70_取得作業日_(),
    人員: 人員,
    報工工站群組: 報工工站群組,
    途程工站群組: 報工工站群組,
    班別清單: 報工作業70_班別清單_(),
    不良原因: 不良原因,
    異常類型: 報工作業70_異常類型_(),
    筆數: {
      人員: 人員.length,
      報工工站群組: 報工工站群組.length,
      產品: 產品原始.length,
      機台: 機台原始.length,
      不良代碼: 不良原因.Z.length + 不良原因.Y.length,
      照片索引: 照片索引.__筆數 || 0
    }
  };
}

/** 07_報工作業V2.html 的正式報工寫入入口。 */
function 寫入報工作業v2(資料) {
  資料 = 資料 || {};
  var 工號 = 報工作業70_文字_(資料.工號);
  var 產品編號 = 報工作業70_文字_(資料.產品編號);
  var 品名 = 報工作業70_文字_(資料.品名);
  var 工站名稱 = 報工作業70_文字_(資料.報工工站名稱 || 資料.工站名稱);
  var 今日共做數 = 報工作業70_數值_(資料.今日共做數);
  var 不良數 = 報工作業70_數值_(資料.不良數);

  if (!工號) throw new Error('請選擇作業員，工號不可空白');
  if (!產品編號 && !品名) throw new Error('請選擇產品');
  if (!工站名稱) throw new Error('請選擇報工工站');
  if (今日共做數 <= 0) throw new Error('今日共做數必須大於 0');
  if (不良數 < 0) throw new Error('不良數不可小於 0');
  if (不良數 > 今日共做數) throw new Error('不良數不可大於今日共做數');

  var 鎖 = LockService.getScriptLock();
  鎖.waitLock(30000);
  try {
    var 試算表 = 報工作業70_取得正式主庫_();
    var 報工表 = 報工作業70_取得或建立表_(試算表, '09_報工');
    var 現在 = new Date();
    var 報工編號 = 報工作業70_文字_(資料.報工編號) || 報工作業70_流水號_('RFV2');
    var 實際良品數 = Math.max(今日共做數 - 不良數, 0);
    var 照片結果 = 報工作業70_儲存現場照片_(資料.現場照片清單 || [], {
      報工編號: 報工編號,
      工號: 工號,
      產品編號: 產品編號,
      作業日: 報工作業70_取得作業日_(現在)
    });

    var 必要欄位 = [
      '報工編號', '時間戳', '作業日', '工號', '姓名', '班別', '是否加班', '加班類型',
      '工單號', '產品編號', '客戶品號', '品名', '工站名稱', '報工工站名稱', '工序',
      '工序清單', '機台清單', '主機台', '今日共做數', '產出數量', '不良數量', '實際良品數',
      '不良率', '開始時間', '結束時間', '實際工時', '異常類型', '備註', '現場照片JSON',
      '來源', '狀態', '更新時間'
    ];
    報工作業70_確保欄位_(報工表, 必要欄位);

    var 物件 = {
      報工編號: 報工編號,
      時間戳: 現在,
      作業日: 報工作業70_取得作業日_(現在),
      工號: 工號,
      姓名: 報工作業70_文字_(資料.姓名),
      班別: 報工作業70_文字_(資料.班別) || 報工作業70_判斷班別_(現在),
      是否加班: 報工作業70_文字_(資料.是否加班) || '否',
      加班類型: 報工作業70_文字_(資料.加班類型) || '無',
      工單號: 報工作業70_文字_(資料.工單號 || 資料.工單編號),
      產品編號: 產品編號,
      客戶品號: 報工作業70_文字_(資料.客戶品號),
      品名: 品名,
      工站名稱: 工站名稱,
      報工工站名稱: 工站名稱,
      工序: 報工作業70_文字_(資料.工序),
      工序清單: 報工作業70_文字_(資料.工序清單 || 資料.工序),
      機台清單: 報工作業70_文字_(資料.機台清單),
      主機台: 報工作業70_文字_(資料.主機台),
      今日共做數: 今日共做數,
      產出數量: 今日共做數,
      不良數量: 不良數,
      實際良品數: 實際良品數,
      不良率: 今日共做數 ? 不良數 / 今日共做數 : 0,
      開始時間: 報工作業70_文字_(資料.開始時間),
      結束時間: 報工作業70_文字_(資料.結束時間),
      實際工時: 報工作業70_文字_(資料.實際工時),
      異常類型: 報工作業70_文字_(資料.異常類型),
      備註: 報工作業70_文字_(資料.備註),
      現場照片JSON: JSON.stringify(照片結果),
      來源: '07_報工作業V2_' + 報工作業70_版本,
      狀態: '有效',
      更新時間: 現在
    };

    報工作業70_依表頭新增_(報工表, 物件);
    return {
      成功: true,
      訊息: '報工資料已寫入 09_報工',
      報工編號: 報工編號,
      作業日: 物件.作業日,
      班別: 物件.班別,
      今日共做數: 今日共做數,
      不良數: 不良數,
      實際良品數: 實際良品數,
      照片數: 照片結果.length,
      正式主資料庫ID: 報工作業70_正式主庫ID
    };
  } finally {
    鎖.releaseLock();
  }
}

/** 07_報工作業V2.html 的正式不良明細寫入入口。 */
function 寫入不良紀錄v2(資料) {
  資料 = 資料 || {};
  var 明細 = Array.isArray(資料.不良行清單) ? 資料.不良行清單.slice() : [];
  if (!明細.length && 報工作業70_數值_(資料.不良數) > 0) {
    明細.push({
      類別: 報工作業70_文字_(資料.不良類別),
      代碼: 報工作業70_文字_(資料.不良代碼),
      名稱: 報工作業70_文字_(資料.不良原因 || 資料.不良名稱),
      英文名稱: 報工作業70_文字_(資料.不良英文),
      數量: 報工作業70_數值_(資料.不良數)
    });
  }
  明細 = 明細.filter(function(項目) { return 報工作業70_數值_(項目.數量) > 0; });
  if (!明細.length) return { 成功: true, 訊息: '無不良資料，略過寫入', 寫入筆數: 0 };

  var 鎖 = LockService.getScriptLock();
  鎖.waitLock(30000);
  try {
    var 試算表 = 報工作業70_取得正式主庫_();
    var 不良表 = 報工作業70_取得或建立表_(試算表, '09_不良紀錄');
    var 必要欄位 = [
      '不良編號', '時間戳', '作業日', '報工編號', '工單號', '工號', '姓名', '班別',
      '產品編號', '客戶品號', '品名', '工站名稱', '工序', '機台清單', '主機台',
      '不良代碼', '不良名稱', '英文名稱', '不良數量', '責任歸屬', '異常類型',
      '異常開始時間', '異常結束時間', '異常工時', '備註', '分類', '來源', '狀態', '更新時間'
    ];
    報工作業70_確保欄位_(不良表, 必要欄位);

    var 報工編號 = 報工作業70_文字_(資料.報工編號);
    var 已存在 = 報工作業70_既有不良鍵_(不良表, 報工編號);
    var 寫入筆數 = 0;
    for (var i = 0; i < 明細.length; i++) {
      var 項目 = 明細[i] || {};
      var 代碼 = 報工作業70_文字_(項目.代碼 || 項目.不良代碼);
      var 鍵 = 報工編號 + '|' + 代碼;
      if (報工編號 && 已存在[鍵]) continue;
      var 現在 = new Date();
      var 物件 = {
        不良編號: 報工作業70_流水號_('NG'),
        時間戳: 現在,
        作業日: 報工作業70_取得作業日_(現在),
        報工編號: 報工編號,
        工單號: 報工作業70_文字_(資料.工單號 || 資料.工單編號),
        工號: 報工作業70_文字_(資料.工號),
        姓名: 報工作業70_文字_(資料.姓名),
        班別: 報工作業70_文字_(資料.班別),
        產品編號: 報工作業70_文字_(資料.產品編號),
        客戶品號: 報工作業70_文字_(資料.客戶品號),
        品名: 報工作業70_文字_(資料.品名),
        工站名稱: 報工作業70_文字_(資料.工站名稱 || 資料.報工工站名稱),
        工序: 報工作業70_文字_(資料.工序),
        機台清單: 報工作業70_文字_(資料.機台清單),
        主機台: 報工作業70_文字_(資料.主機台),
        不良代碼: 代碼,
        不良名稱: 報工作業70_文字_(項目.名稱 || 項目.不良名稱),
        英文名稱: 報工作業70_文字_(項目.英文名稱 || 項目.不良英文),
        不良數量: 報工作業70_數值_(項目.數量),
        責任歸屬: 報工作業70_文字_(項目.責任歸屬 || 資料.責任歸屬),
        異常類型: 報工作業70_文字_(資料.異常類型),
        異常開始時間: 報工作業70_文字_(資料.異常開始時間),
        異常結束時間: 報工作業70_文字_(資料.異常結束時間),
        異常工時: 報工作業70_文字_(資料.異常工時),
        備註: 報工作業70_文字_(資料.備註),
        分類: 報工作業70_文字_(項目.類別),
        來源: '07_報工作業V2_' + 報工作業70_版本,
        狀態: '有效',
        更新時間: 現在
      };
      報工作業70_依表頭新增_(不良表, 物件);
      已存在[鍵] = true;
      寫入筆數++;
    }
    return { 成功: true, 訊息: '不良明細已寫入 09_不良紀錄', 報工編號: 報工編號, 寫入筆數: 寫入筆數 };
  } finally {
    鎖.releaseLock();
  }
}

function 測試70_報工作業V2正式主庫接線() {
  var 資料 = 取得報工作業v2初始資料();
  return {
    成功: 資料.成功,
    版本: 資料.版本,
    正式主資料庫ID: 資料.正式主資料庫ID,
    筆數: 資料.筆數,
    第一位人員: 資料.人員[0] || null,
    第一筆工站: 資料.報工工站群組[0] || null
  };
}

function 報工作業70_取得正式主庫_() {
  return SpreadsheetApp.openById(報工作業70_正式主庫ID);
}

function 報工作業70_讀表_(試算表, 分頁名稱) {
  var 工作表 = 試算表.getSheetByName(分頁名稱);
  if (!工作表 || 工作表.getLastRow() < 2 || 工作表.getLastColumn() < 1) return [];
  var 值 = 工作表.getRange(1, 1, 工作表.getLastRow(), 工作表.getLastColumn()).getDisplayValues();
  var 表頭 = 值[0].map(報工作業70_文字_);
  var 結果 = [];
  for (var r = 1; r < 值.length; r++) {
    var 原始 = 值[r];
    if (!原始.some(function(項目) { return 報工作業70_文字_(項目) !== ''; })) continue;
    var 物件 = { __列號: r + 1, __原始: 原始.slice() };
    for (var c = 0; c < 表頭.length; c++) {
      if (表頭[c] && 物件[表頭[c]] === undefined) 物件[表頭[c]] = 原始[c];
    }
    結果.push(物件);
  }
  return 結果;
}

function 報工作業70_整理人員_(列, 照片索引) {
  return 列.map(function(項目) {
    var 工號 = 報工作業70_取值_(項目, ['工號', '員工編號', '人員編號']);
    var 照片 = 報工作業70_找照片_(照片索引, '人員', [工號, 報工作業70_取值_(項目, ['姓名'])]);
    var 照片網址 = 報工作業70_取值_(項目, ['人員照片網址', '照片網址', '圖片網址']) || 照片.照片網址;
    var 縮圖網址 = 報工作業70_取值_(項目, ['人員縮圖網址', '縮圖網址']) || 照片.縮圖網址 || 照片網址;
    return {
      工號: 工號,
      姓名: 報工作業70_取值_(項目, ['姓名', '中文名']),
      部門: 報工作業70_取值_(項目, ['部門']),
      組別: 報工作業70_取值_(項目, ['組別']),
      職稱: 報工作業70_取值_(項目, ['職稱', '職位']),
      班別: 報工作業70_標準班別_(報工作業70_取值_(項目, ['班別', '班次'])),
      原始班別: 報工作業70_取值_(項目, ['班別', '班次']),
      啟用: 報工作業70_取值_(項目, ['啟用', '狀態']) || '是',
      人員類型: 報工作業70_取值_(項目, ['角色類型', '人員類型', '職稱', '部門']),
      照片網址: 報工作業70_轉圖片網址_(照片網址),
      縮圖網址: 報工作業70_轉圖片網址_(縮圖網址),
      Google檔案ID: 報工作業70_取值_(項目, ['人員照片檔案ID', '照片檔案ID']) || 照片.Google檔案ID,
      條碼: 報工作業70_取值_(項目, ['條碼', '工牌號', '卡號'])
    };
  }).filter(function(項目) {
    return (項目.工號 || 項目.姓名) && 項目.啟用 !== '否' && 項目.啟用 !== '停用';
  });
}

function 報工作業70_建立產品索引_(列, 照片索引) {
  var 索引 = {};
  列.forEach(function(項目) {
    var 原始 = 項目.__原始 || [];
    var 產品編號 = 報工作業70_取值_(項目, ['產品編號', '料號']);
    var 客戶品號 = 報工作業70_取值_(項目, ['客戶品號', '客戶料號']);
    var 品名 = 報工作業70_取值_(項目, ['品名', '產品名稱']);
    if (!品名 && 原始.length >= 3) {
      產品編號 = 報工作業70_文字_(原始[0]);
      客戶品號 = 報工作業70_文字_(原始[1]);
      品名 = 報工作業70_文字_(原始[2]);
    }
    if (!產品編號 && !品名) return;
    var 照片 = 報工作業70_找照片_(照片索引, '產品', [產品編號, 客戶品號, 品名]);
    var 物件 = {
      產品編號: 產品編號,
      客戶品號: 客戶品號,
      品名: 品名,
      產品照片網址: 報工作業70_轉圖片網址_(報工作業70_取值_(項目, ['產品照片網址', '照片網址']) || 照片.照片網址),
      產品縮圖網址: 報工作業70_轉圖片網址_(報工作業70_取值_(項目, ['產品縮圖網址', '縮圖網址']) || 照片.縮圖網址),
      產品照片檔案ID: 報工作業70_取值_(項目, ['產品照片檔案ID', '照片檔案ID']) || 照片.Google檔案ID,
      標準產能: 報工作業70_取值_(項目, ['標準產能_班', '8小時標準產能', '產能8H']),
      標準工時_秒: 報工作業70_取值_(項目, ['標準工時_秒'])
    };
    [產品編號, 客戶品號, 品名, 報工作業70_去前導零_(產品編號)].forEach(function(鍵) {
      鍵 = 報工作業70_鍵_(鍵);
      if (鍵) 索引[鍵] = 物件;
    });
  });
  return 索引;
}

function 報工作業70_建立機台索引_(列, 照片索引) {
  var 索引 = {};
  列.forEach(function(項目) {
    var 原始 = 項目.__原始 || [];
    var 機台編號 = 報工作業70_取值_(項目, ['機台編號', '設備編號']);
    if (!機台編號) return;
    var 照片 = 報工作業70_找照片_(照片索引, '機台', [機台編號, 'MH-' + 機台編號]);
    var 物件 = {
      機台編號: 機台編號,
      設備名稱: 報工作業70_取值_(項目, ['機台名稱', '設備名稱']),
