function 報工作業70_取值_(物件, 欄位清單) {
  for (var i = 0; i < 欄位清單.length; i++) {
    var 值 = 報工作業70_文字_(物件[欄位清單[i]]);
    if (值) return 值;
  }
  return '';
}

function 報工作業70_拆清單_(值) {
  return 報工作業70_文字_(值)
    .replace(/[()\[\]]/g, '')
    .split(/[,，、;；\/\n]+/)
    .map(function(項目) { return 報工作業70_文字_(項目); })
    .filter(Boolean);
}

function 報工作業70_轉圖片網址_(值) {
  var 文字 = 報工作業70_文字_(值);
  if (!文字) return '';
  var 結果 = 文字.match(/\/file\/d\/([^/]+)/) || 文字.match(/[?&]id=([^&]+)/);
  return 結果 && 結果[1] ? 'https://drive.google.com/thumbnail?id=' + 結果[1] + '&sz=w800' : 文字;
}

function 報工作業70_標準班別_(值) {
  var 文字 = 報工作業70_文字_(值).toUpperCase();
  if (文字.indexOf('NIGHT') >= 0 || 文字.indexOf('大夜') >= 0 || 文字.indexOf('夜班') >= 0) return '大夜班';
  if (文字.indexOf('SWING') >= 0 || 文字.indexOf('中班') >= 0) return '中班';
  if (文字.indexOf('OVERTIME') >= 0 || 文字.indexOf('加班') >= 0) return '加班';
  return '早班';
}

function 報工作業70_判斷班別_(日期) {
  var 時分 = Number(Utilities.formatDate(日期 || new Date(), 報工作業70_時區, 'HHmm'));
  if (時分 >= 750 && 時分 < 1650) return '早班';
  if (時分 >= 1650 || 時分 < 110) return '中班';
  return '大夜班';
}

function 報工作業70_取得作業日_(日期) {
  var 現在 = 日期 || new Date();
  var 時分 = Number(Utilities.formatDate(現在, 報工作業70_時區, 'HHmm'));
  var 作業日 = new Date(現在.getTime());
  if (時分 < 610) 作業日.setDate(作業日.getDate() - 1);
  return Utilities.formatDate(作業日, 報工作業70_時區, 'yyyy-MM-dd');
}

function 報工作業70_流水號_(前綴) {
  return 前綴 + '-' + Utilities.formatDate(new Date(), 報工作業70_時區, 'yyyyMMddHHmmssSSS') + '-' + Math.floor(Math.random() * 900 + 100);
}

function 報工作業70_去前導零_(值) {
  var 文字 = 報工作業70_文字_(值);
  return /^\d+$/.test(文字) ? 文字.replace(/^0+/, '') : 文字;
}

function 報工作業70_鍵_(值) {
  return 報工作業70_文字_(值).toUpperCase().replace(/[\s_-]+/g, '');
}

function 報工作業70_數值_(值) {
  var 數字 = Number(報工作業70_文字_(值).replace(/,/g, ''));
  return isFinite(數字) ? 數字 : 0;
}

function 報工作業70_文字_(值) {
  return String(值 === null || 值 === undefined ? '' : 值).trim();
}
